// Non-sensitive defaults. Personal values belong in config/Local.xcconfig,
// which is ignored by git.

APPLE_DEVELOPMENT_TEAM =
APP_BUNDLE_ID_PREFIX = dev.local.alarm-applewatch
IOS_APP_BUNDLE_ID = $(APP_BUNDLE_ID_PREFIX)
WATCH_APP_BUNDLE_ID = $(APP_BUNDLE_ID_PREFIX).watchkitapp

#include? "Local.xcconfig"
